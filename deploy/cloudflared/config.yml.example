# Cloudflare named tunnel for sunnah-toolkit: the public site plus admin SSH,
# both on stable hostnames, with no inbound ports on the host.
#
# Setup (the 2015 MBP deploy used the standalone cloudflared binary in ~):
#   1. cloudflared tunnel login                 # pick the zone in the browser
#   2. cloudflared tunnel create sunnah
#   3. cp config.yml.example ~/.cloudflared/config.yml
#      and fill in the tunnel UUID, USERNAME and your hostnames below
#   4. cloudflared tunnel route dns sunnah example.com
#      cloudflared tunnel route dns sunnah ssh.example.com
#   5. cloudflared tunnel ingress validate
#   6. sudo deploy/macos/install.sh tunnel      # LaunchDaemon, starts at boot
#
# SSH clients connect through the tunnel with:
#   ProxyCommand cloudflared access ssh --hostname %h
#
# Auth: /v1/* routes can require a bearer token when the server is started
# with a keys file. Rate limiting is handled at the Cloudflare edge, not in
# the app.

tunnel: REPLACE-WITH-TUNNEL-UUID
credentials-file: /Users/USERNAME/.cloudflared/REPLACE-WITH-TUNNEL-UUID.json

ingress:
  - hostname: example.com
    service: http://localhost:8000
  - hostname: ssh.example.com
    service: ssh://localhost:22
  - service: http_status:404
