<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Public HTTPS entry point: the free ngrok static domain -> localhost:8000.
     Authtoken lives in ngrok's own config (`ngrok config add-authtoken`),
     never in this file. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sunnah-toolkit.ngrok</string>
  <key>UserName</key><string>__USER__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/ngrok</string>
    <string>http</string>
    <string>--url=https://devouring-hurling-flap.ngrok-free.dev</string>
    <string>--log=stdout</string>
    <string>8000</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>HOME</key><string>__HOME__</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/ngrok.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/ngrok.log</string>
</dict>
</plist>
