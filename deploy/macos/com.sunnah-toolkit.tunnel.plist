<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Named Cloudflare tunnel: stable hostnames for the site and SSH, routed by
     the ingress rules in ~/.cloudflared/config.yml (see
     deploy/cloudflared/config.yml.example). Replaces the ngrok and
     ssh-tunnel services. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sunnah-toolkit.tunnel</string>
  <key>UserName</key><string>__USER__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/cloudflared</string>
    <string>tunnel</string><string>--no-autoupdate</string>
    <string>--config</string><string>__HOME__/.cloudflared/config.yml</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>HOME</key><string>__HOME__</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/cloudflared-tunnel.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/cloudflared-tunnel.log</string>
</dict>
</plist>
